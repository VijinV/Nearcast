{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nearcast",
  "version": "0.4.0",
  "identifier": "com.nearcast.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Nearcast",
        "width": 480,
        "height": 780,
        "minWidth": 400,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Share your screen over Wi-Fi",
    "longDescription": "Open-source app that shares your screen to any browser on the same network.",
    "copyright": "Copyright (c) 2026 vijinvinod and Nearcast contributors. MIT License.",
    "license": "MIT",
    "licenseFile": "../LICENSE",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
